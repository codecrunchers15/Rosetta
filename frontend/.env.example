# Leave empty to run on built-in sample data (the three demo commits).
# Set to the backend origin (e.g. http://localhost:4000) to use the real /api routes.
NEXT_PUBLIC_API_BASE=

# Demo repository the three sample chips point at.
NEXT_PUBLIC_DEMO_REPO=code-crunchers/rosetta-demo

# Linked from the nav ("GitHub") and footer ("Source code").
NEXT_PUBLIC_SOURCE_URL=https://github.com/code-crunchers/rosetta
