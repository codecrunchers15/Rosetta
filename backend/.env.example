# Copy to .env.local. Everything is optional for local development:
# with nothing set, the demo commits still work and data is saved to .data/store.json.

# GitHub: raises the rate limit and is required to post Ask Why comments.
GITHUB_TOKEN=

# Gemini (Google AI Studio free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback model, any OpenAI-compatible API. Groq by default; for OpenRouter use
# FALLBACK_BASE_URL=https://openrouter.ai/api/v1 and an OpenRouter model id.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=openai/gpt-oss-120b

# Firestore (service account). When unset, the local JSON file store is used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n for line breaks.
FIREBASE_PRIVATE_KEY=

# Signs login tokens. Required in production; any long random string.
SESSION_SECRET=

# Frontend origins allowed to call this API (comma separated).
ALLOWED_ORIGINS=http://localhost:3000

# Must match the frontend's NEXT_PUBLIC_DEMO_REPO.
DEMO_REPO=code-crunchers/rosetta-demo
MAX_DIFF_LINES=400

# Where the local JSON store lives when Firestore is not configured.
DATA_DIR=
